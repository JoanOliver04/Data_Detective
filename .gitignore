# ==============================================================================
# DATA DETECTIVE - VALENCIA
# Repositorio PÚBLICO en GitHub
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 🔒 SEGURIDAD - CLAVES, TOKENS Y CONFIGURACIÓN SENSIBLE
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
secrets.*
credentials.*
api_keys.*

# Streamlit: ignorar secretos locales, conservar la config publica
.streamlit/secrets.toml
config.local.*

# ──────────────────────────────────────────────────────────────────────────────
# 🐍 PYTHON
# ──────────────────────────────────────────────────────────────────────────────
# Entornos virtuales
env_data_detective/
venv/
.venv/

# Bytecode y cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Distribución / packaging
build/
dist/
*.egg-info/
.eggs/

# ──────────────────────────────────────────────────────────────────────────────
# 📊 DATOS - BIG DATA (NO SUBIR A GITHUB)
# ──────────────────────────────────────────────────────────────────────────────
# Datos en crudo (históricos y streaming)
1.DATOS_EN_CRUDO/**/*.csv
1.DATOS_EN_CRUDO/**/*.json
1.DATOS_EN_CRUDO/**/*.xml
1.DATOS_EN_CRUDO/**/*.xlsx
1.DATOS_EN_CRUDO/**/*.parquet
1.DATOS_EN_CRUDO/**/*.txt

# Datos limpios / procesados
3.DATOS_LIMPIOS/**/*.csv
3.DATOS_LIMPIOS/**/*.json
3.DATOS_LIMPIOS/**/*.xlsx
3.DATOS_LIMPIOS/**/*.parquet

# Estadísticas y resultados intermedios
3.DATOS_LIMPIOS/estadisticas/**
3.DATOS_LIMPIOS/impacto_eventos/**

# Excepciones: archivos pequeños de ejemplo (para demo)
!1.DATOS_EN_CRUDO/**/ejemplo_*.csv
!1.DATOS_EN_CRUDO/**/sample_*.json
!3.DATOS_LIMPIOS/**/ejemplo_*.csv

# ──────────────────────────────────────────────────────────────────────────────
# 🗂️ LOGS, STREAMING Y EXPORTACIONES
# ──────────────────────────────────────────────────────────────────────────────
# Logs
# Logs
logs/*.log
logs/**/*.log

# Permitir informes markdown
!logs/**/*.md


# Exportaciones generadas por la app (CSV, Excel)
exports/
exported_data/
descargas/

# Datos temporales de streaming
temp/
tmp/

# ──────────────────────────────────────────────────────────────────────────────
# 📈 VISUALIZACIONES GENERADAS
# ──────────────────────────────────────────────────────────────────────────────
# Mapas y gráficos generados automáticamente
4.VISUALIZACIONES/**/*.html
4.VISUALIZACIONES/**/*.png
4.VISUALIZACIONES/**/*.jpg
4.VISUALIZACIONES/**/*.svg

# (Opcional) permitir una imagen representativa
!4.VISUALIZACIONES/ejemplo_*.png

# ──────────────────────────────────────────────────────────────────────────────
# 💻 SISTEMA OPERATIVO
# ──────────────────────────────────────────────────────────────────────────────
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
._*

# Linux
.directory
.Trash-*

# ──────────────────────────────────────────────────────────────────────────────
# 🧠 IDEs / EDITORES
# ──────────────────────────────────────────────────────────────────────────────
# VS Code
.vscode/

# PyCharm
.idea/
*.iml

# ──────────────────────────────────────────────────────────────────────────────
# 🧪 TESTING / QA
# ──────────────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Temporales pandas / sistema
*.tmp
*.bak
*.swp


# ==============================================================================
# NOTAS:
# 1. Los datos reales (Big Data) NO se suben a GitHub
# 2. Las API Keys viven SOLO en .env (ignorado)
# 3. El repo contiene código + estructura + ejemplos mínimos
# ==============================================================================
