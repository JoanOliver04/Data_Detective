# ==============================================================================
# DATA DETECTIVE - VALENCIA  ·  Plantilla de variables de entorno
# ==============================================================================
# Copia este archivo a ".env" (en la raiz del proyecto) y rellena tus claves.
# El archivo ".env" esta en .gitignore y NUNCA debe subirse al repositorio.
# Tambien sirve como marcador para localizar PROJECT_ROOT (utils/paths.py).
#
#   cp .env.example .env
#
# Todas las claves son de planes gratuitos (sin tarjeta):
#   - AEMET OpenData:  https://opendata.aemet.es/centrodedescargas/altaUsuario
#   - OpenWeatherMap:  https://openweathermap.org/api
#   - AQICN / WAQI:    https://aqicn.org/data-platform/token/
# ==============================================================================

# Calidad del aire en tiempo real (AQICN / WAQI)
AQI_TOKEN=tu_token_aqicn_aqui

# Meteorologia actual + pronostico 72h (OpenWeatherMap)
OWM_API_KEY=tu_clave_openweathermap_aqui

# Datos historicos de meteorologia (AEMET OpenData)
AEMET_API_KEY=tu_clave_aemet_aqui
